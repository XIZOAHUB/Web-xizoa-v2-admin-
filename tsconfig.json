{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "functions/**/*",
    "lib/**/*",
    "services/**/*",
    "middleware/**/*",
    "types/**/*",
    "utils/**/*",
    "config/**/*"
  ],
  "exclude": ["node_modules", "dist", "frontend"]
}
